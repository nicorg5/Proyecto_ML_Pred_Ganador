# ===================================
# DATABASE CONFIGURATION
# ===================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=laliga_predictor
DB_USER=laliga_user
DB_PASSWORD=your_password_here

# ===================================
# API FOOTBALL CONFIGURATION
# ===================================
# Get your free API key from: https://www.api-football.com/
# Free tier: 100 requests/day
API_FOOTBALL_KEY=your_api_key_here
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# LaLiga league ID in API-Football
LALIGA_LEAGUE_ID=140

# Request configuration
API_REQUEST_TIMEOUT=30
API_MAX_RETRIES=3
API_RETRY_DELAY=2

# ===================================
# WEB SCRAPING CONFIGURATION (LEGACY)
# ===================================
# Base URL for FBRef stats (backup option)
FBREF_BASE_URL=https://fbref.com/en/

# Delay between requests (seconds) to avoid rate limiting
SCRAPING_DELAY=2

# Maximum retries for failed requests
MAX_RETRIES=3

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# ===================================
# MACHINE LEARNING CONFIGURATION
# ===================================
# Path to save trained models
MODEL_PATH=models/

# Random state for reproducibility
RANDOM_STATE=42

# Train/test split ratio
TEST_SIZE=0.2

# Cross-validation folds
CV_FOLDS=5

# ===================================
# LOGGING CONFIGURATION
# ===================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path
LOG_FILE=logs/laliga_predictor.log

# ===================================
# APPLICATION CONFIGURATION
# ===================================
# Application environment: development, staging, production
ENVIRONMENT=development

# Enable debug mode (development only)
DEBUG=True
